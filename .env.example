# Copy to .env (never commit .env) or export these in your shell.

# Hugging Face model id or local path. Default: Qwen/Qwen2.5-1.5B-Instruct
QUICKVERDICT_MODEL=
# If set, every request must send `Authorization: Bearer <this value>`. Leave empty for no auth (localhost only).
QUICKVERDICT_API_KEY=
# Optional: score with an OpenAI-compatible server that returns logprobs, e.g. http://localhost:8080/v1
QUICKVERDICT_API_BASE=
# Bearer key for that server (hosted providers). States are sent to it.
QUICKVERDICT_BACKEND_API_KEY=
